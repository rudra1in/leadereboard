# GameX Leaderboard Backend - Environment Configuration

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://gamex:gamex_password@localhost:5432/gamex_leaderboard

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# SQL logging (development only)
DB_ECHO_SQL=false

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# API Documentation
ENABLE_DOCS=true
ENABLE_REDOC=true

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,*
CORS_CREDENTIALS=true

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log format (json or text)
LOG_FORMAT=text

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable features
FEATURE_FEDERATION_IMPORTS=true
FEATURE_QUALIFICATION_SCENARIOS=true
FEATURE_OFFLINE_SUPPORT=true

# ============================================================================
# RANKING ENGINE CONFIGURATION
# ============================================================================

# Default time window (rolling-12, ytd, current, all-time)
DEFAULT_TIME_WINDOW=rolling-12

# Default decay factor (0.0 to 1.0)
DEFAULT_DECAY_FACTOR=0.0

# Max events per ranking (0 = unlimited)
DEFAULT_MAX_EVENTS=0

# Ranking computation batch size
RANKING_BATCH_SIZE=1000

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Prometheus metrics
ENABLE_METRICS=false
METRICS_PORT=9090

# Logging service (optional)
LOG_SERVICE_URL=

# Error tracking (Sentry, etc.)
ERROR_TRACKING_URL=

# ============================================================================
# CACHE CONFIGURATION (Optional)
# ============================================================================

# Redis cache (optional)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# ============================================================================
# SECURITY
# ============================================================================

# API key authentication (optional)
API_KEY_ENABLED=false
API_KEY_HEADER=X-API-Key

# Admin token (for admin endpoints)
ADMIN_TOKEN=your-secret-admin-token

# JWT secret (if using JWT)
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256

# ============================================================================
# NOTES
# ============================================================================

# For development:
#   - Use SQLite: sqlite:///./gamex_leaderboard.db
#   - Or local PostgreSQL

# For production:
#   - Use managed PostgreSQL (AWS RDS, Azure Database, etc.)
#   - Set DEBUG=false
#   - Configure CORS properly
#   - Use strong ADMIN_TOKEN
#   - Enable ENABLE_METRICS=true
#   - Configure ERROR_TRACKING_URL

# To use this file:
#   1. Copy to .env
#   2. Update values for your environment
#   3. Never commit .env to version control

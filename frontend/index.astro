---
// Full leaderboard page with SSR and pagination
// This page is server-rendered and optimized for SEO

import MainLayout from '../../layouts/MainLayout.astro';
import LeaderboardTable from '../../components/LeaderboardTable';

// Get page from query parameters
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1'));
const pageSize = 50;

// SSR: Fetch leaderboard data on the server
const apiUrl = process.env.PRIVATE_API_URL || 'http://kong:8000/api/v1';
let leaderboardData = { entries: [], total_users: 0, page: 1, page_size: pageSize, total_pages: 1 };
let error = null;

try {
  const response = await fetch(`${apiUrl}/leaderboard?page=${page}&page_size=${pageSize}`);
  if (response.ok) {
    leaderboardData = await response.json();
  } else {
    error = 'Failed to load leaderboard';
  }
} catch (e) {
  error = 'API connection error';
}

const title = `Leaderboard - Page ${page}`;
const description = `Global leaderboard rankings - Page ${page} of ${leaderboardData.total_pages || 1}`;
---

<MainLayout title={title} description={description}>
  <div class="container">
    <div class="header">
      <h1>Global Leaderboard</h1>
      <p>Compete with players worldwide and climb the ranks</p>
    </div>

    {error ? (
      <div class="error-box">
        <p>{error}</p>
      </div>
    ) : (
      <>
        <LeaderboardTable 
          client:load 
          entries={leaderboardData.entries} 
          page={page}
          pageSize={pageSize}
          totalPages={leaderboardData.total_pages}
          totalUsers={leaderboardData.total_users}
        />

        {leaderboardData.total_pages > 1 && (
          <div class="pagination">
            {page > 1 && (
              <a href={`/leaderboard?page=${page - 1}`} class="btn">← Previous</a>
            )}

            <div class="page-info">
              Page {page} of {leaderboardData.total_pages}
            </div>

            {page < leaderboardData.total_pages && (
              <a href={`/leaderboard?page=${page + 1}`} class="btn">Next →</a>
            )}
          </div>
        )}
      </>
    )}
  </div>
</MainLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-md);
  }

  .header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .header h1 {
    font-size: 2rem;
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-md);
  }

  .header p {
    font-size: 1.125rem;
    color: var(--color-gray-600);
  }

  .error-box {
    background-color: #fee2e2;
    border: 1px solid #fca5a5;
    color: #991b1b;
    padding: var(--spacing-lg);
    border-radius: 0.75rem;
    margin-bottom: var(--spacing-xl);
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-md);
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-xl);
    border-top: 1px solid var(--color-gray-200);
  }

  .btn {
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-primary);
    color: white;
    border-radius: 0.375rem;
    text-decoration: none;
    font-weight: 500;
    transition: background-color 0.2s;

    &:hover {
      background-color: var(--color-primary-dark);
    }

    &:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }

  .page-info {
    color: var(--color-gray-600);
    font-weight: 500;
    min-width: 150px;
    text-align: center;
  }

  @media (max-width: 768px) {
    .header h1 {
      font-size: 1.5rem;
    }

    .pagination {
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
